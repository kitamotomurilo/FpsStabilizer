<Window x:Class="FpsStabilizer.UI.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FpsStabilizer.UI.Views"
        xmlns:vm="clr-namespace:FpsStabilizer.UI.ViewModels"
        xmlns:conv="clr-namespace:FpsStabilizer.UI.Converters"
        mc:Ignorable="d"
        Title="Configurações"
        Height="600"
        Width="550"
        MinHeight="550"
        MinWidth="500"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MainWindowStyle}"
        ResizeMode="CanResizeWithGrip"
        d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel, IsDesignTimeCreatable=False}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Content -->
            <RowDefinition Height="Auto"/>  <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="20,16">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="40" Height="40" Fill="White" Opacity="0.2" Margin="0,0,16,0">
                    <Ellipse.OpacityMask>
                        <VisualBrush Visual="{Binding ElementName=settingsIcon}"/>
                    </Ellipse.OpacityMask>
                </Ellipse>
                <Path x:Name="settingsIcon" Data="M12,2 C13.1,2 14,2.9 14,4 L14,10 C14,11.1 13.1,12 12,12 C10.9,12 10,11.1 10,10 L10,4 C10,2.9 10.9,2 12,2 Z M12,14 C16.42,14 20,15.79 20,20 L20,22 L4,22 L4,20 C4,15.79 7.58,14 12,14 Z" Fill="White" Width="20" Height="20" Stretch="Uniform"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Configurações" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock Text="Personalize o comportamento do FPS Stabilizer" FontSize="12" Foreground="White" Opacity="0.8"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" Style="{StaticResource ModernScrollViewerStyle}" Padding="16">
            <StackPanel>

                <!-- General Section -->
                <GroupBox Header="Geral" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <CheckBox Content="Iniciar com o Windows"
                                  IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                  Style="{StaticResource ModernCheckBoxStyle}" Margin="0,4"/>
                        <TextBlock Text="Inicia automaticamente minimizado na bandeja do sistema" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="24,0,0,8"/>

                        <CheckBox Content="Iniciar minimizado na bandeja"
                                  IsChecked="{Binding StartMinimized, Mode=TwoWay}"
                                  Style="{StaticResource ModernCheckBoxStyle}" Margin="0,4"/>

                        <CheckBox Content="Minimizar para bandeja ao fechar janela"
                                  IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"
                                  Style="{StaticResource ModernCheckBoxStyle}" Margin="0,4"/>

                        <CheckBox Content="Iniciar monitoramento automaticamente"
                                  IsChecked="{Binding AutoStartMonitoring, Mode=TwoWay}"
                                  Style="{StaticResource ModernCheckBoxStyle}" Margin="0,4"/>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Intervalo de detecção:" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="Medium"/>
                            <Slider Grid.Column="1" Minimum="1" Maximum="60" Value="{Binding DetectionIntervalSeconds, Mode=TwoWay}"
                                    Style="{StaticResource ModernSliderStyle}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                            <TextBlock Grid.Column="2" Text="{Binding DetectionIntervalSeconds, StringFormat='{}s'}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" MinWidth="30"/>
                        </Grid>
                        <TextBlock Text="Frequência de verificação de jogos em execução" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- RTSS Integration Section -->
                <GroupBox Header="Integração RTSS (RivaTuner Statistics Server)" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <CheckBox Content="Habilitar integração com RTSS para limite de FPS"
                                  IsChecked="{Binding EnableRtssIntegration, Mode=TwoWay}"
                                  Style="{StaticResource ModernCheckBoxStyle}" Margin="0,4"/>
                        <TextBlock Text="RTSS é necessário para limitar FPS com precisão. Baixe em guru3d.com" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="24,0,0,8"/>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Caminho do RTSS:" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="Medium"/>
                            <TextBox Grid.Column="1" Text="{Binding RtssPath}" IsReadOnly="True"
                                     Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Content="Procurar..." Command="{Binding BrowseRtssPathCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6"/>
                        </Grid>

                        <TextBlock Grid.ColumnSpan="3" FontSize="12" Margin="0,8,0,0" FontWeight="Medium">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="RTSS n&#227;o encontrado ou desabilitado"/>
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EnableRtssIntegration}" Value="True">
                                            <Setter Property="Text" Value="RTSS ativo e pronto"/>
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </GroupBox>

                <!-- Windows Gaming Optimizations Section -->
                <GroupBox Header="Otimizações do Windows para Jogos" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Game Mode" FontWeight="Medium"/>
                                <TextBlock Text="Otimiza recursos do sistema para jogos" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>

                            <Ellipse Grid.Column="1" Width="12" Height="12" VerticalAlignment="Center" Margin="8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                        <Setter Property="ToolTip" Value="Desativado"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGameModeEnabled}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                <Setter Property="ToolTip" Value="Ativado"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Button Grid.Column="2" Content="Ativar" Command="{Binding EnableGameModeCommand}" Padding="12,6" Margin="8,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGameModeEnabled}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Grid.Column="2" Content="Configura&#231;&#245;es" Command="{Binding OpenGameModeSettingsCommand}" Padding="12,6" Margin="8,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGameModeEnabled}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <Separator Style="{StaticResource ModernSeparatorStyle}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="GPU Scheduling (Hardware-Accelerated)" FontWeight="Medium"/>
                                <TextBlock Text="Reduz latência permitindo GPU gerenciar sua memória (requer reinicialização)" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>

                            <Ellipse Grid.Column="1" Width="12" Height="12" VerticalAlignment="Center" Margin="8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource ErrorBrush}"/>
                                        <Setter Property="ToolTip" Value="Desativado"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGameModeEnabled}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}"/>
                                                <Setter Property="ToolTip" Value="Ativado"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <Button Grid.Column="2" Content="Ativar (Requer Admin)" Command="{Binding EnableGpuSchedulingCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="12,6" Margin="8,0,0,0"
                                    Visibility="{Binding IsGpuSchedulingEnabled, Converter={StaticResource BoolToVis}, ConverterParameter=Visible|Collapsed}"/>
                            <Button Grid.Column="2" Content="Configura&#231;&#245;es" Command="{Binding OpenGameModeSettingsCommand}" Padding="12,6" Margin="8,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGameModeEnabled}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <Separator Style="{StaticResource ModernSeparatorStyle}"/>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Opções de Energia" Command="{Binding OpenPowerOptionsCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" Margin="0,0,8,0"/>
                            <Button Content="Modo de Jogo do Windows" Command="{Binding OpenGameModeSettingsCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <!-- Advanced Section -->
                <GroupBox Header="Avançado" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <Button Content="Verificar Atualizações" Command="{Binding CheckForUpdatesCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" HorizontalAlignment="Left" Margin="0,0,0,8"/>

                        <Separator Style="{StaticResource ModernSeparatorStyle}"/>

                        <Button Content="Restaurar Padrões" Command="{Binding ResetToDefaultsCommand}" Style="{StaticResource DangerButtonStyle}" Padding="12,6" HorizontalAlignment="Left"/>
                        <TextBlock Text="Remove todas as configurações e perfis personalizados" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </GroupBox>

                <!-- About Section -->
                <GroupBox Header="Sobre" Style="{StaticResource ModernGroupBoxStyle}">
                    <StackPanel>
                        <TextBlock Text="FPS Stabilizer" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding AppVersion, StringFormat='Versão {0}'}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>

                        <TextBlock Text="Gerenciador de perfis de performance para jogos" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>

                        <TextBlock Text="Funcionalidades:" FontWeight="Medium" Margin="0,8,0,4"/>
                        <StackPanel Margin="16,0,0,0">
                            <TextBlock Text="• Limite de FPS via RTSS (RivaTuner Statistics Server)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="• Prioridade de processo e afinidade de CPU" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="• Detecção automática de jogos" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="• Perfis por jogo com aplicação automática" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="• Integração com otimizações do Windows (Game Mode, GPU Scheduling)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <TextBlock Text="Requisitos:" FontWeight="Medium" Margin="0,12,0,4"/>
                        <StackPanel Margin="16,0,0,0">
                            <TextBlock Text="• Windows 10/11" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="• .NET 8 Runtime" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Text="• RTSS (opcional, para limite de FPS)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceVariantBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Fechar" Click="Close_Click" Style="{StaticResource PrimaryButtonStyle}" Padding="24,8"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>