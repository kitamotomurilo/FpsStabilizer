<Window x:Class="FpsStabilizer.UI.Views.ProfileEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FpsStabilizer.UI.Views"
        xmlns:vm="clr-namespace:FpsStabilizer.UI.ViewModels"
        xmlns:conv="clr-namespace:FpsStabilizer.UI.Converters"
        xmlns:models="clr-namespace:FpsStabilizer.Core.Models;assembly=FpsStabilizer.Core"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        Height="750"
        Width="650"
        MinHeight="650"
        MinWidth="600"
        WindowStartupLocation="CenterOwner"
        Style="{StaticResource MainWindowStyle}"
        ResizeMode="CanResizeWithGrip"
        d:DataContext="{d:DesignInstance Type=vm:ProfileEditorViewModel, IsDesignTimeCreatable=False}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:EnumToBoolConverter x:Key="EnumToBool" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:AffinityModeToStringConverter x:Key="AffinityToString" />
        <conv:ProcessPriorityToStringConverter x:Key="PriorityToString" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="*"/>     <!-- Content -->
            <RowDefinition Height="Auto"/>  <!-- Footer Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Ellipse Grid.Column="0" Width="40" Height="40" Fill="White" Opacity="0.2" Margin="0,0,16,0">
                    <Ellipse.OpacityMask>
                        <VisualBrush Visual="{Binding ElementName=profileIcon}"/>
                    </Ellipse.OpacityMask>
                </Ellipse>
                <Path x:Name="profileIcon" Data="M12,2 C13.1,2 14,2.9 14,4 L14,10 C14,11.1 13.1,12 12,12 C10.9,12 10,11.1 10,10 L10,4 C10,2.9 10.9,2 12,2 Z M12,14 C16.42,14 20,15.79 20,20 L20,22 L4,22 L4,20 C4,15.79 7.58,14 12,14 Z" Fill="White" Width="20" Height="20" Stretch="Uniform"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding WindowTitle}" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                    <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="White" Opacity="0.8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" Style="{StaticResource ModernScrollViewerStyle}" Padding="16">
            <StackPanel>

                <!-- Basic Info Section -->
                <GroupBox Header="Informações Básicas" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Nome do Perfil:" VerticalAlignment="Center" Margin="0,0,12,8" FontWeight="Medium"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Profile.Name, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                 Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,8"
                                 ToolTip="Nome identificador do perfil"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Nome do Processo:" VerticalAlignment="Center" Margin="0,0,12,8" FontWeight="Medium"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AvailableProcesses}"
                                  Text="{Binding Profile.ProcessName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                  IsEditable="True" Style="{StaticResource ModernComboBoxStyle}" Margin="0,0,0,8"
                                  ToolTip="Nome do executável do jogo (ex: cs2, valorant, minecraft)"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Caminho do Executável:" VerticalAlignment="Center" Margin="0,0,12,8" FontWeight="Medium"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Profile.ExecutablePath, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                 Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,8"
                                 ToolTip="Caminho completo opcional para identificação precisa"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Argumentos de Inicialização:" VerticalAlignment="Center" Margin="0,0,12,8" FontWeight="Medium"/>
                        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Profile.LaunchArguments, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 ToolTip="Argumentos passados ao iniciar o jogo"/>
                    </Grid>
                </GroupBox>

                <!-- FPS Limit Section -->
                <GroupBox Header="Limite de FPS (via RTSS)" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                  Content="Usar RTSS para limitar FPS"
                                  IsChecked="{Binding Profile.UseRtss, Mode=TwoWay}"
                                  Style="{StaticResource ModernCheckBoxStyle}" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Limite de FPS:" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="Medium"/>
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="30" Maximum="360" Value="{Binding Profile.FpsLimit, Mode=TwoWay, TargetNullValue=144}"
                                Style="{StaticResource ModernSliderStyle}" IsSnapToTickEnabled="True" TickFrequency="1" Margin="0,0,12,0"
                                ToolTip="Limite máximo de frames por segundo"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Profile.FpsLimit, StringFormat='{}FPS: {0}'}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}" MinWidth="70"/>

                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="30 FPS" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,8,0" Tag="30" Click="PresetFps_Click"/>
                            <Button Content="60 FPS" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,8,0" Tag="60" Click="PresetFps_Click"/>
                            <Button Content="120 FPS" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,8,0" Tag="120" Click="PresetFps_Click"/>
                            <Button Content="144 FPS" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="0,0,8,0" Tag="144" Click="PresetFps_Click"/>
                            <Button Content="240 FPS" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Tag="240" Click="PresetFps_Click"/>
                            <Button Content="Ilimitado" Style="{StaticResource SecondaryButtonStyle}" Padding="10,4" Margin="8,0,0,0" Tag="0" Click="PresetFps_Click"/>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <!-- Priority Section -->
                <GroupBox Header="Prioridade do Processo" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <RadioButton Content="Idle (Mínima)" IsChecked="{Binding Profile.Priority, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ProcessPriority.Idle}}"
                                     Style="{StaticResource ModernRadioButtonStyle}" Margin="0,4"/>
                        <RadioButton Content="Below Normal" IsChecked="{Binding Profile.Priority, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ProcessPriority.BelowNormal}}"
                                     Style="{StaticResource ModernRadioButtonStyle}" Margin="0,4"/>
                        <RadioButton Content="Normal (Padrão)" IsChecked="{Binding Profile.Priority, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ProcessPriority.Normal}}"
                                     Style="{StaticResource ModernRadioButtonStyle}" Margin="0,4"/>
                        <RadioButton Content="Above Normal" IsChecked="{Binding Profile.Priority, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ProcessPriority.AboveNormal}}"
                                     Style="{StaticResource ModernRadioButtonStyle}" Margin="0,4"/>
                        <RadioButton Content="High (Recomendado para jogos)" IsChecked="{Binding Profile.Priority, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ProcessPriority.High}}"
                                     Style="{StaticResource ModernRadioButtonStyle}" Margin="0,4" FontWeight="Medium"/>
                        <RadioButton Content="Real Time (Cuidado: pode travar o sistema)" IsChecked="{Binding Profile.Priority, Converter={StaticResource EnumToBool}, ConverterParameter={x:Static models:ProcessPriority.RealTime}}"
                                     Style="{StaticResource ModernRadioButtonStyle}" Margin="0,4" Foreground="{StaticResource WarningBrush}"/>
                    </StackPanel>
                </GroupBox>

                <!-- CPU Affinity Section -->
                <GroupBox Header="Afinidade de CPU" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <CheckBox Grid.Row="0" Content="Habilitar afinidade de CPU personalizada"
                                  IsChecked="{Binding Profile.CpuAffinity.Enabled, Mode=TwoWay}"
                                  Style="{StaticResource ModernCheckBoxStyle}" FontWeight="Medium"/>

                        <ComboBox Grid.Row="1" ItemsSource="{Binding AvailableCores}" SelectedValue="{Binding Profile.CpuAffinity.Mode, Mode=TwoWay}"
                                  Style="{StaticResource ModernComboBoxStyle}" Margin="0,8,0,8" Width="250" HorizontalAlignment="Left">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource AffinityToString}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Grid.Row="2" Text="{Binding CoreSelectionText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,8"/>

                        <!-- Core Grid -->
                        <ItemsControl Grid.Row="3" ItemsSource="{Binding AvailableCores}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" MaxWidth="550"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding StringFormat='Core {0}'}"
                                              IsChecked="{Binding DataContext.Profile.CpuAffinity.CoreIndices, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource NullToVis}, ConverterParameter={Binding}}"
                                              Tag="{Binding}"
                                              Click="CoreCheckBox_Click"
                                              Style="{StaticResource ModernCheckBoxStyle}"
                                              Margin="4,2" Padding="8,4" FontSize="11"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </GroupBox>

                <!-- Advanced Section -->
                <GroupBox Header="Avançado" Style="{StaticResource ModernGroupBoxStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                  Content="Aplicar perfil automaticamente quando jogo detectado"
                                  IsChecked="{Binding Profile.AutoApply, Mode=TwoWay}"
                                  Style="{StaticResource ModernCheckBoxStyle}" FontWeight="Medium" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Variáveis de Ambiente:" VerticalAlignment="Top" Margin="0,0,12,8" FontWeight="Medium"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Profile.EnvironmentVariables, Converter={StaticResource NullToVis}}" AcceptsReturn="True" Height="80"
                                 Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,8"
                                 ToolTip="Formato: VARIAVEL=valor (uma por linha)"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Diretório de Trabalho:" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="Medium"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Profile.WorkingDirectory, Mode=TwoWay}"
                                 Style="{StaticResource ModernTextBoxStyle}"/>
                    </Grid>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceVariantBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancelar" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="16,8" Margin="0,0,8,0"/>
                <Button Content="Salvar" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="24,8"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>