<Window x:Class="FpsStabilizer.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FpsStabilizer.UI.Views"
        xmlns:vm="clr-namespace:FpsStabilizer.UI.ViewModels"
        xmlns:conv="clr-namespace:FpsStabilizer.UI.Converters"
        xmlns:models="clr-namespace:FpsStabilizer.Core.Models;assembly=FpsStabilizer.Core"
        mc:Ignorable="d"
        Title="FPS Stabilizer"
        Height="700"
        Width="1100"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource MainWindowStyle}"
        Icon="../assets/icon.ico"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel, IsDesignTimeCreatable=False}">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:ProcessPriorityToStringConverter x:Key="PriorityToString" />
        <conv:AffinityModeToStringConverter x:Key="AffinityToString" />
        <conv:BytesToStringConverter x:Key="BytesToString" />
        <conv:TimeSpanToStringConverter x:Key="TimeSpanToString" />
        <conv:ValueToColorConverter x:Key="CpuToColor" GreenThreshold="70" YellowThreshold="40" />
        <conv:ValueToColorConverter x:Key="MemToColor" GreenThreshold="80" YellowThreshold="60" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Toolbar -->
            <RowDefinition Height="*"/>     <!-- Main Content -->
            <RowDefinition Height="Auto"/>  <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: App Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="24" Height="24" Fill="{StaticResource PrimaryBrush}" Margin="0,0,8,0">
                        <Ellipse.OpacityMask>
                            <VisualBrush Visual="{Binding ElementName=iconPath}"/>
                        </Ellipse.OpacityMask>
                    </Ellipse>
                    <Path x:Name="iconPath" Data="M12,2 L22,12 L12,22 L2,12 Z M12,6 L18,12 L12,18 L6,12 Z" Fill="White" Width="14" Height="14" Stretch="Uniform"/>
                    <TextBlock Text="FPS Stabilizer" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>

                <!-- Center: Quick Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Content="🔄 Atualizar" Command="{Binding RefreshGamesCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="12,6"/>
                    <Button Content="⚙ Perfis" Command="{Binding OpenProfileEditorCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="12,6"/>
                    <Button Content="🔧 Config" Command="{Binding OpenSettingsCommand}" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6"/>
                </StackPanel>

                <!-- Right: Monitoring Toggle -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center"
                             Fill="{Binding IsMonitoring, Converter={StaticResource CpuToColor}}"/>
                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Padding="16,6" FontSize="12">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                <Setter Property="Content" Value="Iniciar"/>
                                <Setter Property="Command" Value="{Binding StartMonitoringCommand}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonitoring}" Value="True">
                                        <Setter Property="Content" Value="Parar"/>
                                        <Setter Property="Command" Value="{Binding StopMonitoringCommand}"/>
                                        <Setter Property="Background" Value="#DC3545"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>  <!-- Detected Games -->
                <ColumnDefinition Width="Auto"/>  <!-- Splitter -->
                <ColumnDefinition Width="3*"/>  <!-- Profiles / Details -->
            </Grid.ColumnDefinitions>

            <!-- Detected Games Panel -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource SurfaceVariantBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8" CornerRadius="6,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Jogos Detectados" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding DetectedGames.Count, StringFormat='({0})'}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <Button Grid.Column="2" Content="➕ Adicionar Perfil" Command="{Binding OpenProfileEditorCommand}" Style="{StaticResource IconButtonStyle}" ToolTip="Criar novo perfil"/>
                        </Grid>
                    </Border>

                    <ListView Grid.Row="1" ItemsSource="{Binding DetectedGames}" SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                              Style="{StaticResource ModernListViewStyle}" BorderThickness="0" Padding="4">
                    </ListView>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" Background="Transparent"
                          ShowsPreview="True" DragIncrement="1"/>

            <!-- Profiles Panel -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource SurfaceVariantBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8" CornerRadius="6,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Perfis Disponíveis" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding Profiles.Count, StringFormat='({0})'}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="📤" Command="{Binding ExportProfilesCommand}" Style="{StaticResource IconButtonStyle}" ToolTip="Exportar perfis" Margin="0,0,4,0"/>
                                <Button Content="📥" Command="{Binding ImportProfilesCommand}" Style="{StaticResource IconButtonStyle}" ToolTip="Importar perfis" Margin="0,0,4,0"/>
                                <Button Content="➕" Command="{Binding OpenProfileEditorCommand}" Style="{StaticResource IconButtonStyle}" ToolTip="Novo perfil"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ListView Grid.Row="1" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                              Style="{StaticResource ModernListViewStyle}" BorderThickness="0" Padding="4">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource GridViewColumnHeaderStyle}">
                                <GridViewColumn Header="Nome" Width="180">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="8" Height="8" Fill="{Binding IsActive, Converter={StaticResource CpuToColor}}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="Medium"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Processo" Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ProcessName}" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="FPS" Width="60">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FpsLimit, StringFormat='{}{0} FPS'}" HorizontalAlignment="Center"
                                                       Foreground="{Binding FpsLimit, Converter={StaticResource CpuToColor}}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Prioridade" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Priority, Converter={StaticResource PriorityToString}}"
                                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Afinidade" Width="130">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CpuAffinity.Mode, Converter={StaticResource AffinityToString}}"
                                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" FontSize="11"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Auto" Width="45">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding AutoApply}" IsEnabled="False" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>

                    <!-- Action Buttons -->
                    <Border Grid.Row="2" Background="{StaticResource SurfaceVariantBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,8" CornerRadius="0,0,6,6">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Aplicar Perfil" Command="{Binding ApplyProfileToSelectedCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}" Padding="16,8" Margin="0,0,8,0"
                                    IsEnabled="{Binding SelectedGame, Converter={StaticResource NullToVis}, ConverterParameter={x:Static Visibility.Visible}}"
                                    ToolTip="Aplica o perfil selecionado ao jogo selecionado"/>
                            <Button Content="Remover Perfil" Command="{Binding RemoveProfileFromSelectedCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" Padding="16,8"
                                    IsEnabled="{Binding SelectedGame.MatchedProfileId, Converter={StaticResource NullToVis}, ConverterParameter={x:Static Visibility.Visible}}"
                                    ToolTip="Remove o perfil aplicado e restaura configurações padrão"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="RTSS: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding RtssPath}" FontSize="11" Foreground="{Binding IsRtssAvailable, Converter={StaticResource CpuToColor}}"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <TextBlock Text="CPU: " FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding HardwareInfo.CpuLogicalProcessors, StringFormat='{}Cores: {0}'}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text=" | GPU: " FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="8,0,0,0"/>
                    <TextBlock Text="{Binding HardwareInfo.GpuName}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>